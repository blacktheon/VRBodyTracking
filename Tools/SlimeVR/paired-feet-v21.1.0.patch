+package dev.slimevr.websocketapi
+
+import com.fasterxml.jackson.databind.JsonNode
+import com.fasterxml.jackson.databind.node.JsonNodeFactory
+import com.fasterxml.jackson.databind.node.ObjectNode
+import dev.slimevr.VRServer
+import dev.slimevr.tracking.trackers.Tracker
+import dev.slimevr.tracking.trackers.TrackerStatus
+import dev.slimevr.tracking.trackers.VerticalAccelerationSample
+import org.java_websocket.WebSocket
+import org.java_websocket.exceptions.WebsocketNotConnectedException
+import java.util.concurrent.ConcurrentHashMap
+
+/** Optional physical-IMU polling on the stock WebSocket; each headset owns one player slot. */
+internal class PairedFeet(private val server: VRServer) {
+	private class Session(var slot: Int = 0, var lastPollMillis: Long = 0)
+
+	private val sessions = ConcurrentHashMap<WebSocket, Session>()
+	private val json = JsonNodeFactory.instance
+
+	// Capture saved labels before tracker input starts. A duplicate on an unplugged board
+	// must still be treated as ambiguous. Live GUI names take over when each sensor appears.
+	private val unseenLabels = server.configManager.vrConfig.getTrackers()
+		.filterKeys { it.startsWith("udp:") || HID_TRACKER_ID.matches(it) }
+		.mapValues { it.value.customName }
+		.toMutableMap()
+
+	fun isClient(conn: WebSocket): Boolean = sessions.containsKey(conn)
+
+	fun release(conn: WebSocket) {
+		sessions.remove(conn)
+	}
+
+	fun request(conn: WebSocket, slotNode: JsonNode?) {
+		val session = sessions.computeIfAbsent(conn) { Session() }
+		if (!conn.isOpen) {
+			sessions.remove(conn, session)
+			return
+		}
+		val slot = slotNode?.takeIf { it.isIntegralNumber && it.canConvertToInt() }?.intValue() ?: 0
+		// Tracker registration and slot decisions run on the same VRServer thread.
+		server.queueTask {
+			if (!conn.isOpen || sessions[conn] !== session) return@queueTask
+			val now = VerticalAccelerationSample.nowMillis()
+			val error = when {
+				slot !in 1..3 -> "invalid_slot"
+				session.slot != 0 && session.slot != slot -> "slot_locked"
+				sessions.values.any { it !== session && it.slot == slot && now - it.lastPollMillis < LEASE_MS } -> "slot_in_use"
+				else -> ""
+			}
+			val response = json.objectNode().put("type", TYPE).put("slot", slot).put("error", error)
+			if (error.isEmpty()) {
+				session.slot = slot
+				session.lastPollMillis = now
+				val trackers = server.allTrackers
+				if (unseenLabels.isNotEmpty()) trackers.forEach { unseenLabels.remove(it.name) }
+				response.set<ObjectNode>("left", reading(trackers, "P$slot-L"))
+				response.set<ObjectNode>("right", reading(trackers, "P$slot-R"))
+			} else {
+				response.set<ObjectNode>("left", foot("", false, 0f, 0))
+				response.set<ObjectNode>("right", foot("", false, 0f, 0))
+			}
+			try {
+				conn.send(response.toString())
+			} catch (_: WebsocketNotConnectedException) {
+				// The socket can close between the isOpen check and the asynchronous send.
+			}
+		}
+	}
+
+	private fun reading(trackers: List<Tracker>, label: String): ObjectNode {
+		val sensor = trackers.singleOrNull { it.isPhysicalImu && it.customName == label }
+		if (sensor == null || label in unseenLabels.values) return foot("", false, 0f, 0)
+		val sample = sensor.lastVerticalAcceleration ?: return foot(sensor.name, false, 0f, 0)
+		val valid = sensor.status == TrackerStatus.OK &&
+			sample.validForConnection &&
+			sample.ay.isFinite() &&
+			VerticalAccelerationSample.nowMillis() - sample.timeMillis <= STALE_MS
+		return foot(sensor.name, valid, if (valid) sample.ay else 0f, sample.timeMillis)
+	}
+
+	private fun foot(id: String, valid: Boolean, ay: Float, t: Long): ObjectNode = json.objectNode()
+		.put("id", id)
+		.put("valid", valid)
+		.put("ay", ay)
+		.put("t", t)
+
+	companion object {
+		const val TYPE = "blacktheon.feet.v1"
+		private const val STALE_MS = 250L
+		private const val LEASE_MS = 3_000L
+		private val HID_TRACKER_ID = Regex("[0-9A-Fa-f]{12}/[0-9]+")
+	}
+}
